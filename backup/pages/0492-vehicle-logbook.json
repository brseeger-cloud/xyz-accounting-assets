    "rendered": "<div class=\"xyz-content\"><style>.xyz-content .vlb-shell{box-sizing:border-box;width:100vw;max-width:none;margin-inline:calc(50% - 50vw);padding-inline:max(1.25rem, calc(50vw - 35rem))}.xyz-content .vlb-eyebrow{margin:0;font-family:var(--font-mono);font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--color-ink-soft)}.xyz-content .vlb-h1{margin:.875rem 0 0;font-family:var(--font-sans);font-weight:600;font-size:2.5rem;line-height:1.1;letter-spacing:-.025em;color:var(--color-ink);text-wrap:balance}.xyz-content .vlb-lede{margin:1rem 0 0;font-size:1.0625rem;line-height:1.6;max-width:40rem}.xyz-content .vlb-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin-top:2.5rem;background:var(--color-rule);border:1px solid var(--color-rule);border-radius:4px;overflow:hidden}.xyz-content .vlb-stat{background:#fff;padding:1.25rem}.xyz-content .vlb-stat-l{font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.12em;text-transform:uppercase;color:var(--color-ink-soft)}.xyz-content .vlb-stat-v{font-family:var(--font-mono);font-size:1.75rem;font-weight:700;color:var(--color-ink);letter-spacing:-.02em;font-variant-numeric:tabular-nums;margin-top:.375rem;line-height:1.1}.xyz-content .vlb-stat-pct .vlb-stat-v{color:#0b2119}.xyz-content .vlb-stat-pct{background:#3ddc97}.xyz-content .vlb-stat-pct .vlb-stat-l{color:#0b3a2a}.xyz-content .vlb-stat-n{font-size:.75rem;color:var(--color-ink-soft);margin-top:.25rem}.xyz-content .vlb-stat-pct .vlb-stat-n{color:#13503b}.xyz-content .vlb-panel{border:1px solid var(--color-rule);border-radius:4px;background:#fff;padding:1.5rem;margin-top:1.5rem}.xyz-content .vlb-panel h2{margin:0 0 1rem;font-family:var(--font-mono);font-size:.71875rem;letter-spacing:.12em;text-transform:uppercase;color:var(--color-ink-soft);font-weight:400}.xyz-content .vlb-add{display:grid;grid-template-columns:9.5rem 8rem 8rem 1fr 9rem auto;gap:.625rem;align-items:end}.xyz-content .vlb-f span{display:block;font-size:.75rem;color:var(--color-ink-soft);margin-bottom:.25rem}.xyz-content .vlb-f input,.xyz-content .vlb-f select{width:100%;border:1px solid var(--color-rule);border-radius:3px;padding:.5rem .625rem;font:inherit;font-size:.9375rem;color:var(--color-ink);background:#fff;box-sizing:border-box}.xyz-content .vlb-f input:focus,.xyz-content .vlb-f select:focus{outline:2px solid #3ddc97;outline-offset:-1px;border-color:#3ddc97}.xyz-content .vlb-btn{display:inline-flex;align-items:center;gap:.5rem;border-radius:4px;padding:.75rem 1.25rem;font-weight:600;font-size:.9375rem;text-decoration:none;cursor:pointer;border:1px solid var(--color-ink);background:var(--color-ink);color:var(--color-paper);font-family:inherit;white-space:nowrap}.xyz-content .vlb-btn-mint{background:#3ddc97;border-color:#2fcb88;color:#0b2119}.xyz-content .vlb-btn-mint:hover{background:#2fcb88}.xyz-content .vlb-btn-ghost{background:transparent;color:var(--color-ink);border-color:var(--color-rule)}.xyz-content .vlb-btn-ghost:hover{background:var(--color-paper-sunk)}.xyz-content .vlb-tbl{width:100%;border-collapse:collapse;font-size:.9375rem;margin-top:.25rem}.xyz-content .vlb-tbl th{text-align:left;font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.12em;text-transform:uppercase;color:var(--color-ink-soft);font-weight:400;padding:0 .75rem .5rem 0;border-bottom:1px solid var(--color-ink)}.xyz-content .vlb-tbl td{padding:.625rem .75rem .625rem 0;border-bottom:1px solid var(--color-rule);vertical-align:top}.xyz-content .vlb-tbl .num{text-align:right;font-family:var(--font-mono);font-variant-numeric:tabular-nums;white-space:nowrap}.xyz-content .vlb-tag{display:inline-block;font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.08em;text-transform:uppercase;padding:.1875rem .4375rem;border-radius:3px}.xyz-content .vlb-tag-b{background:#3ddc97;color:#0b2119}.xyz-content .vlb-tag-p{background:var(--color-paper-sunk);color:var(--color-ink-soft)}.xyz-content .vlb-del{border:0;background:none;color:var(--color-ink-soft);cursor:pointer;font-size:.8125rem;padding:0}.xyz-content .vlb-del:hover{color:#c54836}.xyz-content .vlb-empty{padding:2rem 0;color:var(--color-ink-soft);font-size:.9375rem}.xyz-content .vlb-actions{display:flex;flex-wrap:wrap;gap:.625rem;margin-top:1.25rem}.xyz-content .vlb-prog{height:.5rem;background:var(--color-paper-sunk);border-radius:99px;overflow:hidden;margin-top:.75rem}.xyz-content .vlb-prog i{display:block;height:100%;background:#0A7C55;border-radius:99px}.xyz-content .vlb-cols{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:1.5rem}.xyz-content .vlb-note{margin:.75rem 0 0;font-size:.8125rem;color:var(--color-ink-soft);line-height:1.5}.xyz-content .vlb-sec{margin-top:4rem}.xyz-content .vlb-h2{margin:0 0 1rem;font-family:var(--font-sans);font-weight:600;font-size:1.625rem;letter-spacing:-.02em;color:var(--color-ink)}.xyz-content .vlb-prose p{font-size:1rem;line-height:1.65;max-width:44rem}.xyz-content .vlb-prose h3{margin:1.75rem 0 .5rem;font-family:var(--font-sans);font-weight:600;font-size:1.0625rem;color:var(--color-ink)}.xyz-content .vlb-prose ul{max-width:44rem;font-size:1rem;line-height:1.65}@media (max-width:1000px){.xyz-content .vlb-stats{grid-template-columns:1fr 1fr}.xyz-content .vlb-add{grid-template-columns:1fr 1fr}.xyz-content .vlb-cols{grid-template-columns:1fr}.xyz-content .vlb-h1{font-size:2rem}}@media print{body *{visibility:hidden!important}.xyz-content #vlb-print,.xyz-content #vlb-print *{visibility:visible!important}.xyz-content #vlb-print{position:absolute!important;left:0!important;top:0!important;width:100%!important;border:0!important;box-shadow:none!important;padding:0!important;margin:0!important}.xyz-content .vlb-noprint{display:none!important}}</style>\n\n<nav aria-label=\"Breadcrumb\" class=\"vlb-shell\" style=\"padding-top:1.5rem\"><ol style=\"margin:0;padding:0;list-style:none;display:flex;gap:.5rem;font-size:.8125rem;color:var(--color-ink-soft)\"><li><a href=\"/\" style=\"color:inherit;text-decoration:none\">Home</a></li><li aria-hidden=\"true\" style=\"color:var(--color-rule)\">/</li><li><a href=\"/tax-tips/\" style=\"color:inherit;text-decoration:none\">Resources</a></li><li aria-hidden=\"true\" style=\"color:var(--color-rule)\">/</li><li aria-current=\"page\">Vehicle logbook</li></ol></nav>\n\n<div class=\"vlb-shell\" style=\"padding-top:1.5rem\"><p class=\"vlb-eyebrow\">Resources</p><h1 class=\"vlb-h1\">Free ATO vehicle logbook</h1><p class=\"vlb-lede\">Log each trip as you take it. This works out your business-use percentage, tracks the 12-week period the ATO requires, and compares the logbook method against cents per kilometre so you can see which one leaves you better off. Everything stays in this browser.</p></div>\n\n<div class=\"vlb-shell\" id=\"vlb-print\"><div class=\"vlb-stats\"><div class=\"vlb-stat\"><div class=\"vlb-stat-l\">Total kilometres</div><div class=\"vlb-stat-v\" id=\"s-total\">0</div><div class=\"vlb-stat-n\" id=\"s-trips\">No trips yet</div></div><div class=\"vlb-stat\"><div class=\"vlb-stat-l\">Business kilometres</div><div class=\"vlb-stat-v\" id=\"s-bus\">0</div><div class=\"vlb-stat-n\" id=\"s-bustrips\">&nbsp;</div></div><div class=\"vlb-stat vlb-stat-pct\"><div class=\"vlb-stat-l\">Business use</div><div class=\"vlb-stat-v\" id=\"s-pct\">0%</div><div class=\"vlb-stat-n\">Applied to your running costs</div></div><div class=\"vlb-stat\"><div class=\"vlb-stat-l\">12-week period</div><div class=\"vlb-stat-v\" id=\"s-weeks\">—</div><div class=\"vlb-stat-n\" id=\"s-weeknote\">Starts at your first trip</div></div></div>\n\n<div class=\"vlb-panel\"><h2>Trips</h2><table class=\"vlb-tbl\"><thead><tr><th>Date</th><th>Odometer</th><th class=\"num\">Km</th><th>Purpose</th><th>Type</th><th class=\"num vlb-noprint\">&nbsp;</th></tr></thead><tbody id=\"vlb-rows\"></tbody></table><div class=\"vlb-empty\" id=\"vlb-empty\">No trips logged yet. Add your first one below.</div></div></div>\n\n<div class=\"vlb-shell vlb-noprint\"><div class=\"vlb-panel\"><h2>Add a trip</h2><div class=\"vlb-add\"><label class=\"vlb-f\"><span>Date</span><input id=\"t-date\" type=\"date\"></label><label class=\"vlb-f\"><span>Odometer start</span><input id=\"t-start\" type=\"number\" min=\"0\" step=\"1\" placeholder=\"0\"></label><label class=\"vlb-f\"><span>Odometer end</span><input id=\"t-end\" type=\"number\" min=\"0\" step=\"1\" placeholder=\"0\"></label><label class=\"vlb-f\"><span>Purpose of trip</span><input id=\"t-purpose\" type=\"text\" placeholder=\"Client meeting, site visit, supplier run\"></label><label class=\"vlb-f\"><span>Type</span><select id=\"t-type\"><option value=\"business\">Business</option><option value=\"private\">Private</option></select></label><button class=\"vlb-btn vlb-btn-mint\" id=\"t-add\" type=\"button\">Add trip</button></div><p class=\"vlb-note\">The ATO wants the odometer readings, not just the distance. If you only have the distance, put 0 in the start box and the distance in the end box — but the readings are what stands up to a review.</p></div>\n\n<div class=\"vlb-cols\"><div class=\"vlb-panel\" style=\"margin-top:0\"><h2>12-week period</h2><div id=\"vlb-12\"></div><div class=\"vlb-prog\"><i id=\"vlb-bar\" style=\"width:0%\"></i></div><p class=\"vlb-note\">A logbook must cover at least 12 continuous weeks. Once complete it is generally valid for five years, provided your circumstances do not change.</p></div>\n\n<div class=\"vlb-panel\" style=\"margin-top:0\"><h2>Which method suits you</h2><label class=\"vlb-f\" style=\"max-width:12rem\"><span>Cents per kilometre rate</span><input id=\"t-rate\" type=\"number\" min=\"0\" step=\"1\" value=\"88\"></label><p class=\"vlb-note\" style=\"margin-bottom:.75rem\">Confirm the current rate on the ATO site before you rely on it — it is reset each income year.</p><div id=\"vlb-cmp\"></div></div></div>\n\n<div class=\"vlb-actions\"><button class=\"vlb-btn vlb-btn-ghost\" id=\"vlb-csv\" type=\"button\">Download CSV</button><button class=\"vlb-btn vlb-btn-ghost\" id=\"vlb-print-btn\" type=\"button\">Print or save as PDF</button><button class=\"vlb-btn vlb-btn-ghost\" id=\"vlb-clear\" type=\"button\">Clear logbook</button></div>\n<p class=\"vlb-note\">Your trips are saved in this browser only. Clearing your browser data will clear the logbook, so export the CSV periodically if it matters.</p></div>\n\n<div class=\"vlb-shell vlb-sec vlb-noprint\"><h2 class=\"vlb-h2\">How the logbook method works</h2><div class=\"vlb-prose\"><p>There are two ways to claim car expenses, and you can only use one per car per year.</p><h3>Cents per kilometre</h3><p>A flat rate for every business kilometre, capped at 5,000 business kilometres per car per year. No receipts for running costs, but you still need to be able to show how you worked out the kilometres. Simple, and it suits low business use.</p><h3>Logbook method</h3><p>You work out the business-use percentage from a 12-week logbook, then apply that percentage to your actual running costs for the year — fuel, servicing, insurance, registration, interest and depreciation. No 5,000 kilometre cap. If you drive a lot for work, this is almost always the larger claim.</p><h3>What each logbook entry needs</h3><ul><li>The date the trip started and ended</li><li>Odometer readings at the start and end of the trip</li><li>Total kilometres travelled</li><li>Why the trip was for business</li></ul><p>You also record the odometer reading at the start and end of the whole logbook period, and at the start and end of each income year you use the logbook for.</p><h3>What does not count as business</h3><p>Home to work and back is private travel, even if you check email on the way and even if there is no public transport. The main exceptions are carrying bulky tools you cannot leave at work, travelling between two separate workplaces, or where home genuinely is your base of operations.</p><p>Official source: <a href=\"https://www.ato.gov.au/individuals-and-families/income-deductions-offsets-and-records/deductions-you-can-claim/work-related-deductions/cars-transport-and-travel/motor-vehicle-and-car-expenses\" rel=\"noopener noreferrer\" target=\"_blank\">ATO: Car expenses</a>. For the detail on which method suits your situation, see our guide to <a href=\"/tax-tips/motor-vehicle-deduction/\">motor vehicle deductions</a>.</p></div></div>\n\n<div class=\"vlb-shell vlb-sec vlb-noprint\" style=\"padding-bottom:4rem\"><div style=\"border:1px solid var(--color-rule);border-radius:4px;background:#fff;padding:1.75rem\"><h2 style=\"margin:0;font-family:var(--font-sans);font-weight:600;font-size:1.25rem;color:var(--color-ink)\">Let us work out which method wins</h2><p style=\"margin:.625rem 0 1.25rem;font-size:.9375rem;line-height:1.6;max-width:40rem\">Bring the logbook and your running costs and we will calculate both methods, claim the larger one, and keep the workings on file in case the ATO asks.</p><div style=\"display:flex;flex-wrap:wrap;gap:.625rem\"><a class=\"vlb-btn vlb-btn-mint\" href=\"https://brsadvisory.myassembly.com/login?step=signUp\" target=\"_blank\" rel=\"noopener noreferrer\">Start my return</a><a class=\"vlb-btn vlb-btn-ghost\" href=\"/calculators/sole-trader-tax-calculator/\">Sole trader calculator</a></div></div></div>\n\n<script>(function(){var K='xyzLogbook';var trips=[];var $=function(id){return document.getElementById(id);};\nfunction esc(s){return String(s||'').replace(/[\\x26<>]/g,function(c){return {'\\x26':'&amp;','<':'&lt;','>':'&gt;'}[c];});}\nfunction num(n){return Number(n||0).toLocaleString('en-AU');}\nfunction money(n){return '$'+(Math.round(n*100)/100).toLocaleString('en-AU',{minimumFractionDigits:2,maximumFractionDigits:2});}\nfunction dfmt(s){if(!s){return '';}var p=s.split('-');if(p.length!==3){return s;}var m=['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];return Number(p[2])+' '+m[Number(p[1])-1]+' '+p[0];}\nfunction load(){try{trips=JSON.parse(localStorage.getItem(K)||'[]');}catch(e){trips=[];}if(!Array.isArray(trips)){trips=[];}}\nfunction save(){try{localStorage.setItem(K,JSON.stringify(trips));}catch(e){}}\nfunction km(t){return Math.max(0,(Number(t.end)||0)-(Number(t.start)||0));}\nfunction draw(){trips.sort(function(a,b){return (a.date||'').localeCompare(b.date||'');});\nvar tot=0,bus=0,busN=0;var h='';\nfor(var i=0;i<trips.length;i++){var t=trips[i];var d=km(t);tot+=d;if(t.type==='business'){bus+=d;busN++;}\nh+='<tr><td>'+esc(dfmt(t.date))+'</td><td class=\"num\" style=\"text-align:left;font-family:var(--font-mono);font-size:.8125rem;color:var(--color-ink-soft)\">'+num(t.start)+' &rarr; '+num(t.end)+'</td><td class=\"num\">'+num(d)+'</td><td>'+esc(t.purpose||'&mdash;')+'</td><td><span class=\"vlb-tag '+(t.type==='business'?'vlb-tag-b':'vlb-tag-p')+'\">'+(t.type==='business'?'Business':'Private')+'</span></td><td class=\"num vlb-noprint\"><button class=\"vlb-del\" type=\"button\" data-del=\"'+i+'\">Remove</button></td></tr>';}\n$('vlb-rows').innerHTML=h;$('vlb-empty').style.display=trips.length?'none':'block';\nvar pct=tot>0?(bus/tot*100):0;\n$('s-total').textContent=num(tot);$('s-bus').textContent=num(bus);$('s-pct').textContent=(Math.round(pct*10)/10)+'%';\n$('s-trips').textContent=trips.length?(trips.length+(trips.length===1?' trip logged':' trips logged')):'No trips yet';\n$('s-bustrips').innerHTML=busN?(busN+(busN===1?' business trip':' business trips')):'&nbsp;';\ntwelve();compare(bus,pct);save();}\nfunction twelve(){if(!trips.length||!trips[0].date){$('s-weeks').textContent='—';$('s-weeknote').textContent='Starts at your first trip';$('vlb-12').innerHTML='<p style=\"margin:0;font-size:.9375rem;color:var(--color-ink-soft)\">Log your first trip and the 12-week clock starts from that date.</p>';$('vlb-bar').style.width='0%';return;}\nvar st=new Date(trips[0].date+'T00:00:00');var en=new Date(st.getTime());en.setDate(en.getDate()+83);\nvar last=new Date(trips[trips.length-1].date+'T00:00:00');\nvar elapsed=Math.floor((last-st)/86400000)+1;var pctp=Math.max(0,Math.min(100,elapsed/84*100));\nvar done=elapsed>=84;\n$('s-weeks').textContent=(Math.floor(elapsed/7))+'/12';\n$('s-weeknote').textContent=done?'Period complete':'Weeks covered so far';\n$('vlb-12').innerHTML='<div style=\"font-size:.9375rem;line-height:1.7\"><div style=\"display:flex;justify-content:space-between;gap:1rem\"><span>Started</span><span style=\"font-family:var(--font-mono)\">'+esc(dfmt(trips[0].date))+'</span></div><div style=\"display:flex;justify-content:space-between;gap:1rem\"><span>12 weeks ends</span><span style=\"font-family:var(--font-mono)\">'+esc(dfmt(en.toISOString().slice(0,10)))+'</span></div><div style=\"display:flex;justify-content:space-between;gap:1rem\"><span>'+(done?'Status':'Days remaining')+'</span><span style=\"font-family:var(--font-mono);color:'+(done?'#0A7C55':'var(--color-ink)')+'\">'+(done?'Complete':Math.max(0,84-elapsed)+' days')+'</span></div></div>';\n$('vlb-bar').style.width=pctp+'%';}\nfunction compare(bus,pct){var rate=(Number($('t-rate').value)||0)/100;var capped=Math.min(bus,5000);var cpk=capped*rate;\nvar h='<div style=\"font-size:.9375rem;line-height:1.7\"><div style=\"display:flex;justify-content:space-between;gap:1rem\"><span>Cents per km claim</span><span style=\"font-family:var(--font-mono);font-variant-numeric:tabular-nums\">'+money(cpk)+'</span></div>';\nif(bus>5000){h+='<div style=\"font-size:.8125rem;color:#c08a2e\">Capped at 5,000 km — '+num(bus-5000)+' business km fall outside this method.</div>';}\nh+='<div style=\"display:flex;justify-content:space-between;gap:1rem;margin-top:.5rem\"><span>Logbook claim</span><span style=\"font-family:var(--font-mono)\">'+(Math.round(pct*10)/10)+'% of running costs</span></div>';\nvar breakeven=pct>0?cpk/(pct/100):0;\nh+='</div><p class=\"vlb-note\" style=\"margin-top:.875rem\">The logbook method wins once your total running costs for the year exceed <b style=\"color:var(--color-ink);font-family:var(--font-mono)\">'+money(breakeven)+'</b> — fuel, servicing, insurance, registration, interest and depreciation combined.</p>';\n$('vlb-cmp').innerHTML=pct>0?h:'<p style=\"margin:0;font-size:.9375rem;color:var(--color-ink-soft)\">Log a business trip to compare the two methods.</p>';}\n$('t-add').addEventListener('click',function(){var d=$('t-date').value;if(!d){alert('Add the date of the trip.');return;}\nvar s=Number($('t-start').value)||0,e=Number($('t-end').value)||0;\nif(e<s){alert('The closing odometer reading is lower than the opening one.');return;}\nif(e===s){alert('That trip covers no distance — check the odometer readings.');return;}\ntrips.push({date:d,start:s,end:e,purpose:$('t-purpose').value.trim(),type:$('t-type').value});\n$('t-start').value=e;$('t-end').value='';$('t-purpose').value='';draw();});\n$('vlb-rows').addEventListener('click',function(ev){var d=ev.target.dataset.del;if(d!==undefined){trips.splice(Number(d),1);draw();}});\n$('t-rate').addEventListener('input',draw);\n$('vlb-print-btn').addEventListener('click',function(){window.print();});\n$('vlb-clear').addEventListener('click',function(){if(confirm('Remove every trip from this logbook? This cannot be undone.')){trips=[];draw();}});\n$('vlb-csv').addEventListener('click',function(){var r=[['Date','Odometer start','Odometer end','Kilometres','Purpose','Type']];\nfor(var i=0;i<trips.length;i++){var t=trips[i];r.push([t.date,t.start,t.end,km(t),(t.purpose||'').replace(/\"/g,'\"\"'),t.type]);}\nvar csv=r.map(function(row){return row.map(function(c){return '\"'+String(c)+'\"';}).join(',');}).join('\\r\\n');\nvar b=new Blob([csv],{type:'text/csv;charset=utf-8;'});var u=URL.createObjectURL(b);var a=document.createElement('a');a.href=u;a.download='vehicle-logbook.csv';document.body.appendChild(a);a.click();document.body.removeChild(a);URL.revokeObjectURL(u);});\nload();$('t-date').value=new Date().toISOString().slice(0,10);draw();})();</script></div>"
  },
