tant}html:not(#ap) body:not(#ap) #xyz-ax>section{width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw)}html:not(#ap) body:not(#ap) #xyz-ax h1,html:not(#ap) body:not(#ap) #xyz-ax h2,html:not(#ap) body:not(#ap) #xyz-ax h3{font-family:var(--display)}html:not(#ap) body:not(#ap) #xyz-ax ol,html:not(#ap) body:not(#ap) #xyz-ax ul{margin-block:0}html:not(#ap) body:not(#ap) #xyz-ax :is(h1,h2,h3){color:var(--ink)!important}html:not(#ap) body:not(#ap) #xyz-ax :is(.ax-t-navy,.ax-t-navy2,.ax-card-alt) :is(h1,h2,h3){color:#fff!important}</style>\n<p><!-- HERO --></p>\n<section class=\"ax-hero ax-center\">\n<div class=\"ax-shell\">\n<p class=\"ax-eyebrow\">Online tax returns, Australia-wide</p>\n<h1 class=\"ax-h-hero\">Accountant-checked returns.<br />None of the paperwork.</h1>\n<p class=\"ax-lead\">We pull your details from the ATO, find every deduction, and a registered agent signs off before lodgement.</p>\n<div class=\"ax-cta\">\n<div class=\"ax-start\"><a class=\"ax-pill ax-pill-navy\" href=\"https://brsadvisory.myassembly.com/login?step=signUp\" target=\"_blank\" rel=\"noopener noreferrer\"><span class=\"ax-dot\"></span>Start my return<span class=\"ax-arrow\" aria-hidden=\"true\">→</span></a><small>Free until lodgement</small></div>\n<div class=\"ax-links\"><a class=\"ax-tlink\" href=\"/get-a-quote/\">Get a quote</a><a class=\"ax-tlink\" href=\"/contact/\">Contact Us</a></div>\n</div>\n<ul class=\"ax-trust\">\n<li><span><a href=\"/identity-verification/\">Every client ID-verified</a>, no exceptions</span></li>\n<li>Registered tax agent 26233684</li>\n<li>Fixed fee, quoted before we start</li>\n<li>Pay from your refund (+$44)</li>\n<li>256-bit encryption, SOC 2 certified portal</li>\n</ul>\n</div>\n<div class=\"ax-stage\">\n<div class=\"ax-shell\">\n<div class=\"ax-est\" role=\"group\" aria-label=\"Deduction estimator\">\n<div class=\"ax-est-in\" style=\"text-align:left\">\n<div class=\"ax-est-tag\"><span>Deduction estimator · 2025–26</span><span class=\"ax-live\">Live</span></div>\n<p><label class=\"ax-field\" for=\"inc\"><span class=\"ax-row\"><span>Annual income</span><span class=\"ax-val\" id=\"inc-l\">$85,000</span></span><input id=\"inc\" type=\"range\" min=\"20000\" max=\"250000\" step=\"1000\" value=\"85000\"></label><label class=\"ax-field\" for=\"ded\"><span class=\"ax-row\"><span>Work-related deductions</span><span class=\"ax-val\" id=\"ded-l\">$3,000</span></span><input id=\"ded\" type=\"range\" min=\"0\" max=\"15000\" step=\"250\" value=\"3000\"></label></p>\n<div class=\"ax-lines\">\n<div class=\"ax-line\"><span>Taxable income</span><b id=\"taxable\">$82,000</b></div>\n<div class=\"ax-line\"><span>Income tax + Medicare levy</span><b id=\"tax\">$17,028</b></div>\n<div class=\"ax-line\"><span>Marginal rate</span><b id=\"marg\">32%</b></div>\n</div>\n</div>\n<div class=\"ax-give\" style=\"text-align:left\"><span class=\"ax-k\">Your deductions give back</span><span class=\"ax-big\" id=\"saved\" aria-live=\"polite\">$960</span></p>\n<p class=\"ax-note\">An estimate on 2025–26 resident rates. Your accountant will find claims this slider can&#8217;t.</p>\n<div style=\"display:flex;flex-direction:column;align-items:flex-start\"><a class=\"ax-tlink\" href=\"/tax-refund-calculator/\">Full refund calculator</a><a class=\"ax-tlink\" href=\"/deductions/\" style=\"margin-top:10px\">See what people in your job claim</a></div>\n</div>\n</div>\n</div>\n</div>\n</section>\n<p><!-- CREDENTIALS --></p>\n<section class=\"ax-tile ax-t-navy\">\n<div class=\"ax-shell ax-cred\">\n<div>\n<p class=\"ax-eyebrow\">Who reads your return</p>\n<h2 class=\"ax-h-tile\">Benjamin Seeger prepares, reviews and lodges every return.</h2>\n<p class=\"ax-lead\">No offshore processing, no junior handover. The principal&#8217;s name is on the lodgement.</p>\n<p style=\"margin-top:22px\"><a class=\"ax-tlink\" href=\"/about/\">About the practice</a></p>\n</div>\n<ul class=\"ax-cred-list\">\n<li><span>CPA Australia</span><b>FCPA</b></li>\n<li><span>Tax Practitioners Board</span><b>Agent 26233684</b></li>\n</ul>\n</div>\n</section>\n<p><!-- HOW IT WORKS --></p>\n<section class=\"ax-tile ax-t-white\">\n<div class=\"ax-shell\">\n<div class=\"ax-center\">\n<p class=\"ax-eyebrow\">How it works</p>\n<h2 class=\"ax-h-tile\">One portal, with a human at the end of it.</h2>\n</div>\n<ol class=\"ax-steps\">\n<li>\n<h3 class=\"ax-h-card\">Create your portal account</h3>\n<p>Tap Start my return, or Client Portal at the top of any page. Use your email, Google or a one-tap magic link. Nothing is charged until your return is lodged.</p>\n</li>\n<li>\n<h3 class=\"ax-h-card\">Verify your identity, sign one pack</h3>\n<p>A three-minute electronic ID check on your phone, then one document: our engagement, your tax agent authority and TFN consent. <a href=\"/identity-verification/\">Why every client is verified</a>.</p>\n</li>\n<li>\n<h3 class=\"ax-h-card\">Complete your intake form</h3>\n<p>Plain questions about income, work expenses, home office, vehicle, property and trades. Stop and come back; your answers are saved.</p>\n</li>\n<li>\n<h3 class=\"ax-h-card\">Upload your documents</h3>\n<p>Payment summaries, receipts and rental statements go into Files inside the portal, never an email thread. Ask us anything in Messages.</p>\n</li>\n<li>\n<h3 class=\"ax-h-card\">We prepare, you approve</h3>\n<p>A registered agent prepares the return and flags anything missing. You sign the lodgement declaration in the portal and we lodge.</p>\n</li>\n<li>\n<h3 class=\"ax-h-card\">Settle the fee</h3>\n<p>Pay your invoice in Billing, or sign the fee-from-refund authority and we take the fee from your refund instead (an extra $44).</p>\n</li>\n</ol>\n</div>\n</section>\n<p><!-- RETURN TYPES --></p>\n<section class=\"ax-tile ax-t-parch\">\n<div class=\"ax-shell\">\n<div class=\"ax-sec-head\">\n<div>\n<p class=\"ax-eyebrow\">Online returns</p>\n<h2 class=\"ax-h-tile\">Built for how you actually earn.</h2>\n</div>\n<p><a class=\"ax-tlink\" href=\"/online-tax-returns/\">See every return type</a></div>\n<div class=\"ax-grid3\">\n<article class=\"ax-card\">\n<h3 class=\"ax-h-card\">Salary &amp; wage earners</h3>\n<p>One employer or five. Uniform, tools, training and working-from-home hours, all handled in the flow.</p>\n<div class=\"ax-price\"><span>From <b>$99</b></span></div>\n</article>\n<article class=\"ax-card\">\n<h3 class=\"ax-h-card\">Sole traders &amp; freelancers</h3>\n<p>Business schedule, GST position, instant asset write-off and quarterly PAYG in one pass.</p>\n<div class=\"ax-price\"><span>From <b>$299</b></span></div>\n</article>\n<article class=\"ax-card\">\n<h3 class=\"ax-h-card\">Property &amp; share investors</h3>\n<p>Rental schedules, depreciation, CGT on shares and crypto with parcel-level matching.</p>\n<div class=\"ax-price\"><span>From <b>$179</b></span></div>\n</article>\n<article class=\"ax-card\">\n<h3 class=\"ax-h-card\">Companies &amp; trusts</h3>\n<p>Financial statements, Division 7A, trust distributions and the company return, prepared together.</p>\n<div class=\"ax-price\"><span>Fixed fee, quoted first</span><a class=\"ax-tlink\" href=\"/get-a-quote/\">Get a quote</a></div>\n</article>\n<article class=\"ax-card\">\n<h3 class=\"ax-h-card\">Expats &amp; non-residents</h3>\n<p>Residency tests, foreign income, treaty relief and departing-Australia positions, from any timezone.</p>\n<div class=\"ax-price\"><span>Fixed fee, quoted first</span><a class=\"ax-tlink\" href=\"/get-a-quote/\">Get a quote</a></div>\n</article>\n<article class=\"ax-card ax-card-alt\">\n<h3 class=\"ax-h-card\">Behind on lodgements?</h3>\n<p>We catch up prior years, deal with the ATO on your behalf and negotiate a payment plan where one is needed.</p>\n<div class=\"ax-price\"><span>Prior years</span><a class=\"ax-tlink\" href=\"/contact/\">Catch-up returns</a></div>\n</article>\n</div>\n</div>\n</section>\n<p><!-- SECURITY --></p>\n<section class=\"ax-tile ax-t-navy\">\n<div class=\"ax-shell\">\n<p class=\"ax-eyebrow\">Portal security</p>\n<h2 class=\"ax-h-tile\" style=\"max-width:46rem\">Your documents live in a client portal, not an email thread.</h2>\n<p class=\"ax-lead\" style=\"max-width:44rem\">ID, payment summaries, receipts and messages all sit inside our client portal on Assembly. Its authentication, permissions and encryption are independently audited platform infrastructure.</p>\n<div class=\"ax-sec\">\n<div><span class=\"ax-tag\">Verified</span></p>\n<h3>Every client ID-verified</h3>\n<p>Nobody is lodged or registered until they pass an electronic identity check: government document, selfie and AML screening.</p>\n</div>\n<div><span class=\"ax-tag\">Audited</span></p>\n<h3>SOC 2 Type II certified</h3>\n<p>The portal platform is SOC 2 Type II certified and continuously monitored.</p>\n</div>\n<div><span class=\"ax-tag\">Sign-in</span></p>\n<h3>Managed authentication</h3>\n<p>Magic link, Google or password, with multi-factor authentication available on top.</p>\n</div>\n<div><span class=\"ax-tag\">Encrypted</span></p>\n<h3>TLS in transit, AES-256 at rest</h3>\n<p>Encrypted on the way in and while stored. You only ever see your own data.</p>\n</div>\n<div><span class=\"ax-tag\">Private</span></p>\n<h3>Never used to train AI</h3>\n<p>Your documents and messages are never used to train any AI model.</p>\n</div>\n</div>\n<div class=\"ax-sec-links\"><a class=\"ax-tlink\" href=\"https://assembly.com/security\" target=\"_blank\" rel=\"noopener noreferrer\">How Assembly secures the portal</a><a class=\"ax-tlink\" href=\"https://security.assembly.com\" target=\"_blank\" rel=\"noopener noreferrer\">Assembly Trust Center</a><a class=\"ax-tlink\" href=\"/identity-verification/\">How we verify every client</a><a class=\"ax-tlink\" href=\"/legal/privacy/\">Privacy policy</a></div>\n</div>\n</section>\n<p><!-- PRICING --></p>\n<section class=\"ax-tile ax-t-white\">\n<div class=\"ax-shell\">\n<div class=\"ax-center\">\n<p class=\"ax-eyebrow\">Pricing</p>\n<h2 class=\"ax-h-tile\">One price, told to you up front.</h2>\n<p class=\"ax-lead\">Nothing is charged until you approve the finished return.</p>\n</div>\n<div class=\"ax-tiers\">\n<div class=\"ax-tier ax-pick\"><span class=\"ax-flag\">Most people</span><span class=\"ax-name\">Standard</span><span class=\"ax-amt\">$99</span></p>\n<p>Salary, wages, interest, dividends and standard deductions.</p>\n<ul>\n<li>ATO pre-fill</li>\n<li>Accountant review</li>\n<li>Deduct fee from refund ($44)</li>\n</ul>\n</div>\n<div class=\"ax-tier\"><span class=\"ax-name\">Investor</span><span class=\"ax-amt\">$179</span></p>\n<p>Rental properties, share and crypto disposals, depreciation schedules.</p>\n<ul>\n<li>Everything in Standard</li>\n<li>CGT parcel matching</li>\n<li>Rental schedule per property</li>\n</ul>\n</div>\n<div class=\"ax-tier\"><span class=\"ax-name\">Business</span><span class=\"ax-amt\">$299</span></p>\n<p>Sole traders and contractors. Partnerships from $549; companies and trusts quoted separately.</p>\n<ul>\n<li>Business schedule &amp; GST</li>\n<li>Asset write-off review</li>\n<li>BAS on request</li>\n</ul>\n</div>\n</div>\n</div>\n</section>\n<p><!-- QUOTE CTA --></p>\n<section class=\"ax-tile ax-t-parch ax-quote ax-center\">\n<div class=\"ax-shell ax-narrow\">\n<p class=\"ax-eyebrow\">Fixed fee</p>\n<h2 class=\"ax-h-tile\">Company, trust, SMSF or bookkeeping? Get a fixed-fee quote.</h2>\n<p class=\"ax-lead\">Tell us what you need and we&#8217;ll come back with one price, in writing, usually within one business day.</p>\n<div class=\"ax-cta\"><a class=\"ax-pill ax-pill-mint\" href=\"/get-a-quote/\">Get a quote</a><a class=\"ax-tlink\" href=\"/services/pricing/\">See pricing</a></div>\n</div>\n</section>\n<p><script>(function(){var inc=document.getElementById('inc'),ded=document.getElementById('ded');function taxOf(t){if(t>190000)return 51638+(t-190000)*.45;if(t>135000)return 31288+(t-135000)*.37;if(t>45000)return 4288+(t-45000)*.30;if(t>18200)return (t-18200)*.16;return 0;}function levyOf(t){if(t>=35013)return t*.02;if(t>28011)return (t-28011)*.10;return 0;}function margOf(t){var r=0;if(t>=18200)r=16;if(t>=45000)r=30;if(t>=135000)r=37;if(t>=190000)r=45;if(t>=35013)r+=2;else if(t>=28011)r+=10;return r;}function m(n){return '$'+Math.round(n).toLocaleString('en-AU');}function s(id,v){document.getElementById(id).textContent=v;}function fill(el){el.style.setProperty('--p',((el.value-el.min)/(el.max-el.min)*100)+'%');}function draw(){var i=+inc.value,d=+ded.value,t=Math.max(0,i-d);var full=taxOf(i)+levyOf(i),now=taxOf(t)+levyOf(t);s('inc-l',m(i));s('ded-l',m(d));s('taxable',m(t));s('tax',m(now));s('marg',margOf(t)+'%');s('saved',m(full-now));fill(inc);fill(ded);}inc.addEventListener('input',draw);ded.addEventListener('input',draw);draw();})();</script></div>\n<div hidden class=\"xyz-schema\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":[\"AccountingService\",\"ProfessionalService\"],\"@id\":\"https://superblyladyec52fb18e8-stxdq.wpcomstaging.com/#organization\",\"name\":\"XYZ Accounting\",\"url\":\"https://superblyladyec52fb18e8-stxdq.wpcomstaging.com/\",\"logo\":\"https://superblyladyec52fb18e8-stxdq.wpcomstaging.com/wp-content/uploads/2026/10/xyz-accounting-social-share.png\",\"image\":\"https://superblyladyec52fb18e8-stxdq.wpcomstaging.com/wp-content/uploads/2026/10/xyz-accounting-social-share.png\",\"description\":\"Free tools that give you a real number. Real accountants who lodge it.\",\"telephone\":\"+61407179179\",\"email\":\"enquiries@xyzaccounting.com.au\",\"address\":{\"@type\":\"PostalAddress\",\"postOfficeBoxNumber\":\"GPO Box 2440\",\"addressLocality\":\"Adelaide\",\"addressRegion\":\"SA\",\"postalCode\":\"5001\",\"addressCountry\":\"AU\"},\"areaServed\":{\"@type\":\"Country\",\"name\":\"Australia\"},\"openingHoursSpecification\":[{\"@type\":\"OpeningHoursSpecification\",\"dayOfWeek\":[\"Monday\",\"Tuesday\",\"Wednesday\",\"Thursday\",\"Friday\"],\"opens\":\"08:00\",\"closes\":\"21:00\"},{\"@type\":\"Ope