ta-astro-cid-fku4tryq>\n<th scope=\"row\" class=\"font-mono text-[0.8125rem] font-normal normal-case tracking-normal\" data-astro-cid-fku4tryq> $18,201  – $45,000 </th>\n<td class=\"font-mono\" data-astro-cid-fku4tryq> 15% </td>\n<td class=\"font-mono\" data-astro-cid-fku4tryq> 15% of the amount over $18,200 </td>\n</tr>\n<tr data-astro-cid-fku4tryq>\n<th scope=\"row\" class=\"font-mono text-[0.8125rem] font-normal normal-case tracking-normal\" data-astro-cid-fku4tryq> $45,001  – $135,000 </th>\n<td class=\"font-mono\" data-astro-cid-fku4tryq> 30% </td>\n<td class=\"font-mono\" data-astro-cid-fku4tryq> $4,020 plus 30% of the amount over $45,000 </td>\n</tr>\n<tr data-astro-cid-fku4tryq>\n<th scope=\"row\" class=\"font-mono text-[0.8125rem] font-normal normal-case tracking-normal\" data-astro-cid-fku4tryq> $135,001  – $190,000 </th>\n<td class=\"font-mono\" data-astro-cid-fku4tryq> 37% </td>\n<td class=\"font-mono\" data-astro-cid-fku4tryq> $31,020 plus 37% of the amount over $135,000 </td>\n</tr>\n<tr data-astro-cid-fku4tryq>\n<th scope=\"row\" class=\"font-mono text-[0.8125rem] font-normal normal-case tracking-normal\" data-astro-cid-fku4tryq> $190,001  and over </th>\n<td class=\"font-mono\" data-astro-cid-fku4tryq> 45% </td>\n<td class=\"font-mono\" data-astro-cid-fku4tryq> $51,370 plus 45% of the amount over $190,000 </td>\n</tr>\n</tbody>\n</table>\n<p class=\"mt-3 text-[0.8125rem] text-ink-soft\" data-astro-cid-fku4tryq> These rates do not include the 2% Medicare levy. </p>\n<h2 class=\"mt-12 text-xl\" data-astro-cid-fku4tryq>Foreign resident rates 2026–27</h2>\n<table class=\"mt-4\" data-astro-cid-fku4tryq>\n<caption class=\"sr-only\" data-astro-cid-fku4tryq>Foreign resident tax rates for 2026–27</caption>\n<thead data-astro-cid-fku4tryq>\n<tr data-astro-cid-fku4tryq>\n<th scope=\"col\" data-astro-cid-fku4tryq>Taxable income</th>\n<th scope=\"col\" data-astro-cid-fku4tryq>Rate</th>\n</tr>\n</thead>\n<tbody data-astro-cid-fku4tryq>\n<tr data-astro-cid-fku4tryq>\n<th scope=\"row\" class=\"font-mono text-[0.8125rem] font-normal normal-case tracking-normal\" data-astro-cid-fku4tryq> $0  – $135,000 </th>\n<td class=\"font-mono\" data-astro-cid-fku4tryq>30%</td>\n</tr>\n<tr data-astro-cid-fku4tryq>\n<th scope=\"row\" class=\"font-mono text-[0.8125rem] font-normal normal-case tracking-normal\" data-astro-cid-fku4tryq> $135,001  – $190,000 </th>\n<td class=\"font-mono\" data-astro-cid-fku4tryq>37%</td>\n</tr>\n<tr data-astro-cid-fku4tryq>\n<th scope=\"row\" class=\"font-mono text-[0.8125rem] font-normal normal-case tracking-normal\" data-astro-cid-fku4tryq> $190,001  and over </th>\n<td class=\"font-mono\" data-astro-cid-fku4tryq>45%</td>\n</tr>\n</tbody>\n</table>\n<p class=\"mt-3 text-[0.8125rem] text-ink-soft\" data-astro-cid-fku4tryq> No tax-free threshold, and no Medicare levy. </p>\n<h2 class=\"mt-12 text-xl\" data-astro-cid-fku4tryq>Medicare levy 2026–27</h2>\n<table class=\"mt-4\" data-astro-cid-fku4tryq>\n<caption class=\"sr-only\" data-astro-cid-fku4tryq>Medicare levy thresholds for 2026–27</caption>\n<thead data-astro-cid-fku4tryq>\n<tr data-astro-cid-fku4tryq>\n<th scope=\"col\" data-astro-cid-fku4tryq>Threshold</th>\n<th scope=\"col\" data-astro-cid-fku4tryq>No levy up to</th>\n<th scope=\"col\" data-astro-cid-fku4tryq>Full 2% from</th>\n</tr>\n</thead>\n<tbody data-astro-cid-fku4tryq>\n<tr data-astro-cid-fku4tryq>\n<th scope=\"row\" class=\"font-normal normal-case tracking-normal\" data-astro-cid-fku4tryq> Single </th>\n<td class=\"font-mono\" data-astro-cid-fku4tryq>$28,011</td>\n<td class=\"font-mono\" data-astro-cid-fku4tryq> $35,013 </td>\n</tr>\n<tr data-astro-cid-fku4tryq>\n<th scope=\"row\" class=\"font-normal normal-case tracking-normal\" data-astro-cid-fku4tryq> Family </th>\n<td class=\"font-mono\" data-astro-cid-fku4tryq>$47,238</td>\n<td class=\"font-mono\" data-astro-cid-fku4tryq> $59,047 </td>\n</tr>\n<tr data-astro-cid-fku4tryq>\n<th scope=\"row\" class=\"font-normal normal-case tracking-normal\" da