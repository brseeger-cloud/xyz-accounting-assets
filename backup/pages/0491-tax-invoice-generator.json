    "rendered": "<div class=\"xyz-content\">\n<style>.xyz-content .tig-shell{box-sizing:border-box;width:100vw;max-width:none;margin-inline:calc(50% - 50vw);padding-inline:max(1.25rem, calc(50vw - 35rem))}.xyz-content .tig-eyebrow{margin:0;font-family:var(--font-mono);font-size:.75rem;letter-spacing:.12em;text-transform:uppercase;color:var(--color-ink-soft)}.xyz-content .tig-h1{margin:.875rem 0 0;font-family:var(--font-sans);font-weight:600;font-size:2.5rem;line-height:1.1;letter-spacing:-.025em;color:var(--color-ink);text-wrap:balance}.xyz-content .tig-lede{margin:1rem 0 0;font-size:1.0625rem;line-height:1.6;max-width:40rem}.xyz-content .tig-grid{display:grid;grid-template-columns:22rem 1fr;gap:2rem;margin-top:2.5rem;align-items:start}.xyz-content .tig-panel{border:1px solid var(--color-rule);border-radius:4px;background:#fff;padding:1.25rem}.xyz-content .tig-panel+.tig-panel{margin-top:1rem}.xyz-content .tig-panel h2{margin:0 0 .875rem;font-family:var(--font-mono);font-size:.71875rem;letter-spacing:.12em;text-transform:uppercase;color:var(--color-ink-soft);font-weight:400}.xyz-content .tig-f{display:block;margin-bottom:.75rem}.xyz-content .tig-f:last-child{margin-bottom:0}.xyz-content .tig-f span{display:block;font-size:.8125rem;color:var(--color-ink-soft);margin-bottom:.25rem}.xyz-content .tig-f input,.xyz-content .tig-f textarea{width:100%;border:1px solid var(--color-rule);border-radius:3px;padding:.5rem .625rem;font:inherit;font-size:.9375rem;color:var(--color-ink);background:#fff;box-sizing:border-box}.xyz-content .tig-f textarea{min-height:4.5rem;resize:vertical}.xyz-content .tig-f input:focus,.xyz-content .tig-f textarea:focus{outline:2px solid #3ddc97;outline-offset:-1px;border-color:#3ddc97}.xyz-content .tig-row2{display:grid;grid-template-columns:1fr 1fr;gap:.75rem}.xyz-content .tig-check{display:flex;align-items:flex-start;gap:.5rem;font-size:.875rem;line-height:1.4}.xyz-content .tig-check input{margin-top:.15rem;accent-color:#0A7C55}.xyz-content .tig-item{border-top:1px solid var(--color-rule);padding-top:.75rem;margin-top:.75rem;position:relative}.xyz-content .tig-item:first-of-type{border-top:0;padding-top:0;margin-top:0}.xyz-content .tig-del{position:absolute;top:.75rem;right:0;border:0;background:none;color:var(--color-ink-soft);font-size:.8125rem;cursor:pointer;padding:0 .25rem;line-height:1}.xyz-content .tig-item:first-of-type .tig-del{top:0}.xyz-content .tig-del:hover{color:#c54836}.xyz-content .tig-btn{display:inline-flex;align-items:center;gap:.5rem;border-radius:4px;padding:.75rem 1.25rem;font-weight:600;font-size:.9375rem;text-decoration:none;cursor:pointer;border:1px solid var(--color-ink);background:var(--color-ink);color:var(--color-paper);font-family:inherit}.xyz-content .tig-btn-mint{background:#3ddc97;border-color:#2fcb88;color:#0b2119}.xyz-content .tig-btn-mint:hover{background:#2fcb88}.xyz-content .tig-btn-ghost{background:transparent;color:var(--color-ink);border-color:var(--color-rule)}.xyz-content .tig-btn-ghost:hover{background:var(--color-paper-sunk)}.xyz-content .tig-btn-sm{padding:.4375rem .75rem;font-size:.8125rem}.xyz-content .tig-actions{display:flex;flex-wrap:wrap;gap:.625rem;margin-top:1.25rem}.xyz-content .tig-comp{margin-top:1rem;border:1px solid var(--color-rule);border-radius:4px;background:var(--color-paper-sunk);padding:1rem 1.25rem}.xyz-content .tig-comp h2{margin:0 0 .625rem;font-family:var(--font-mono);font-size:.71875rem;letter-spacing:.12em;text-transform:uppercase;color:var(--color-ink-soft);font-weight:400}.xyz-content .tig-comp ul{margin:0;padding:0;list-style:none;font-size:.875rem}.xyz-content .tig-comp li{padding:.3125rem 0 .3125rem 1.5rem;position:relative;line-height:1.45}.xyz-content .tig-comp li::before{position:absolute;left:0;top:.3125rem;font-family:var(--font-mono);font-size:.875rem}.xyz-content .tig-comp li.ok::before{content:'\\2713';color:#0A7C55}.xyz-content .tig-comp li.no::before{content:'\\2022';color:#c08a2e}.xyz-content .tig-comp li.no{color:var(--color-ink-soft)}.xyz-content .tig-doc{border:1px solid var(--color-rule);border-radius:4px;background:#fff;padding:2.5rem;box-shadow:0 10px 15px -3px rgba(16,28,38,.07)}.xyz-content .tig-doc-top{display:flex;justify-content:space-between;gap:2rem;align-items:flex-start;flex-wrap:wrap}.xyz-content .tig-doc-title{font-family:var(--font-sans);font-weight:600;font-size:1.75rem;letter-spacing:-.02em;color:var(--color-ink);margin:0}.xyz-content .tig-doc-meta{font-family:var(--font-mono);font-size:.8125rem;color:var(--color-ink-soft);text-align:right;font-variant-numeric:tabular-nums}.xyz-content .tig-doc-meta b{color:var(--color-ink);font-weight:400}.xyz-content .tig-doc-parties{display:grid;grid-template-columns:1fr 1fr;gap:2rem;margin-top:2rem}.xyz-content .tig-doc-lab{font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.12em;text-transform:uppercase;color:var(--color-ink-soft);margin-bottom:.375rem}.xyz-content .tig-doc-party{font-size:.9375rem;line-height:1.55;white-space:pre-line}.xyz-content .tig-doc-party b{display:block;font-weight:600;color:var(--color-ink)}.xyz-content .tig-tbl{width:100%;border-collapse:collapse;margin-top:2rem;font-size:.9375rem}.xyz-content .tig-tbl th{text-align:left;font-family:var(--font-mono);font-size:.6875rem;letter-spacing:.12em;text-transform:uppercase;color:var(--color-ink-soft);font-weight:400;padding:0 0 .5rem;border-bottom:1px solid var(--color-ink)}.xyz-content .tig-tbl td{padding:.6875rem 0;border-bottom:1px solid var(--color-rule);vertical-align:top}.xyz-content .tig-tbl .num{text-align:right;font-family:var(--font-mono);font-variant-numeric:tabular-nums;white-space:nowrap;padding-left:1rem}.xyz-content .tig-tot{margin-top:1.25rem;margin-left:auto;width:min(18rem,100%)}.xyz-content .tig-tot div{display:flex;justify-content:space-between;gap:1rem;padding:.4375rem 0;font-size:.9375rem}.xyz-content .tig-tot div span:last-child{font-family:var(--font-mono);font-variant-numeric:tabular-nums}.xyz-content .tig-tot .grand{border-top:1px solid var(--color-ink);margin-top:.375rem;padding-top:.625rem;font-weight:600;font-size:1.0625rem}.xyz-content .tig-doc-foot{margin-top:2rem;padding-top:1.25rem;border-top:1px solid var(--color-rule);font-size:.875rem;line-height:1.6;color:var(--color-ink-soft);white-space:pre-line}.xyz-content .tig-gstline{margin-top:1rem;font-size:.875rem;color:var(--color-ink-soft)}.xyz-content .tig-note{margin:.75rem 0 0;font-size:.8125rem;color:var(--color-ink-soft);line-height:1.5}.xyz-content .tig-sec{margin-top:4rem}.xyz-content .tig-h2{margin:0 0 1rem;font-family:var(--font-sans);font-weight:600;font-size:1.625rem;letter-spacing:-.02em;color:var(--color-ink)}.xyz-content .tig-prose p{font-size:1rem;line-height:1.65;max-width:44rem}.xyz-content .tig-prose h3{margin:1.75rem 0 .5rem;font-family:var(--font-sans);font-weight:600;font-size:1.0625rem;color:var(--color-ink)}.xyz-content .tig-prose ul{max-width:44rem;font-size:1rem;line-height:1.65}@media (max-width:1000px){.xyz-content .tig-grid{grid-template-columns:1fr}.xyz-content .tig-doc{padding:1.5rem}.xyz-content .tig-h1{font-size:2rem}}@media print{body *{visibility:hidden!important}.xyz-content #tig-doc,.xyz-content #tig-doc *{visibility:visible!important}.xyz-content #tig-doc{position:absolute!important;left:0!important;top:0!important;width:100%!important;border:0!important;box-shadow:none!important;padding:0!important;margin:0!important}}</style>\n<nav aria-label=\"Breadcrumb\" class=\"tig-shell\" style=\"padding-top:1.5rem\">\n<ol style=\"margin:0;padding:0;list-style:none;display:flex;gap:.5rem;font-size:.8125rem;color:var(--color-ink-soft)\">\n<li><a href=\"/\" style=\"color:inherit;text-decoration:none\">Home</a></li>\n<li aria-hidden=\"true\" style=\"color:var(--color-rule)\">/</li>\n<li><a href=\"/tax-tips/\" style=\"color:inherit;text-decoration:none\">Resources</a></li>\n<li aria-hidden=\"true\" style=\"color:var(--color-rule)\">/</li>\n<li aria-current=\"page\">Tax invoice generator</li>\n</ol>\n</nav>\n<div class=\"tig-shell\" style=\"padding-top:1.5rem\">\n<p class=\"tig-eyebrow\">Resources</p>\n<h1 class=\"tig-h1\">Free tax invoice generator</h1>\n<p class=\"tig-lede\">Fill in the form, watch the invoice build itself, then save it as a PDF. It checks as you go that the invoice carries everything the ATO requires. Nothing is uploaded — your details stay in this browser.</p>\n</div>\n<div class=\"tig-shell tig-grid\">\n<div class=\"tig-noprint\">\n<div class=\"tig-panel\">\n<h2>Your business</h2>\n<p><label class=\"tig-f\"><span>Business name</span><input id=\"f-bizname\" type=\"text\" placeholder=\"Your business or trading name\"></label><label class=\"tig-f\"><span>ABN</span><input id=\"f-bizabn\" type=\"text\" inputmode=\"numeric\" placeholder=\"11 digits\"></label><label class=\"tig-f\"><span>Address</span><textarea id=\"f-bizaddr\" placeholder=\"Street&#10;Suburb STATE 0000\"></textarea></label></p>\n<div class=\"tig-row2\"><label class=\"tig-f\"><span>Email</span><input id=\"f-bizemail\" type=\"email\"></label><label class=\"tig-f\"><span>Phone</span><input id=\"f-bizphone\" type=\"tel\"></label></div>\n<p><label class=\"tig-check\"><input id=\"f-gst\" type=\"checkbox\" checked><span>I am registered for GST (adds 10% and issues a tax invoice)</span></label></p>\n<p class=\"tig-note\">Saved in this browser so your next invoice is prefilled.</p>\n</div>\n<div class=\"tig-panel\">\n<h2>Bill to</h2>\n<p><label class=\"tig-f\"><span>Client name</span><input id=\"f-clname\" type=\"text\"></label><label class=\"tig-f\"><span>Client ABN <span style=\"opacity:.7\">(needed once the total reaches $1,000)</span></span><input id=\"f-clabn\" type=\"text\" inputmode=\"numeric\"></label><label class=\"tig-f\"><span>Client address</span><textarea id=\"f-claddr\"></textarea></label></div>\n<div class=\"tig-panel\">\n<h2>Invoice details</h2>\n<div class=\"tig-row2\"><label class=\"tig-f\"><span>Invoice number</span><input id=\"f-invno\" type=\"text\" placeholder=\"0001\"></label><label class=\"tig-f\"><span>Date issued</span><input id=\"f-invdate\" type=\"date\"></label></div>\n<p><label class=\"tig-f\"><span>Payment due</span><input id=\"f-duedate\" type=\"date\"></label></div>\n<div class=\"tig-panel\">\n<h2>Items</h2>\n<div id=\"tig-items\"></div>\n<p><button class=\"tig-btn tig-btn-ghost tig-btn-sm\" id=\"tig-add\" type=\"button\" style=\"margin-top:.875rem\">Add another item</button></div>\n<div class=\"tig-panel\">\n<h2>Payment and notes</h2>\n<p><label class=\"tig-f\"><span>Payment details and notes</span><textarea id=\"f-notes\" placeholder=\"Account name&#10;BSB 000-000&#10;Account 00000000&#10;&#10;Payment within 14 days, thank you.\"></textarea></label></p>\n<p class=\"tig-note\">This sits at the foot of the invoice. It never leaves your browser.</p>\n</div>\n<div class=\"tig-actions\"><button class=\"tig-btn tig-btn-mint\" id=\"tig-print\" type=\"button\">Download as PDF</button><button class=\"tig-btn tig-btn-ghost\" id=\"tig-reset\" type=\"button\">Clear invoice</button></div>\n<p class=\"tig-note\">&#8220;Download as PDF&#8221; opens your browser&#8217;s print dialog — choose &#8220;Save as PDF&#8221; as the destination.</p>\n<div class=\"tig-comp\">\n<h2>Compliance check</h2>\n<ul id=\"tig-comp\"></ul>\n</div>\n</div>\n<div>\n<div class=\"tig-doc\" id=\"tig-doc\">\n<div class=\"tig-doc-top\">\n<div>\n<h2 class=\"tig-doc-title\" id=\"d-title\">Tax invoice</h2>\n<div class=\"tig-doc-lab\" style=\"margin-top:1.25rem\">From</div>\n<div class=\"tig-doc-party\" id=\"d-from\"><b>Your business name</b></div>\n</div>\n<div class=\"tig-doc-meta\" id=\"d-meta\"></div>\n</div>\n<div class=\"tig-doc-parties\">\n<div>\n<div class=\"tig-doc-lab\">Bill to</div>\n<div class=\"tig-doc-party\" id=\"d-to\">—</div>\n</div>\n</div>\n<table class=\"tig-tbl\">\n<thead>\n<tr>\n<th>Description</th>\n<th class=\"num\">Qty</th>\n<th class=\"num\">Unit price</th>\n<th class=\"num\">Amount</th>\n</tr>\n</thead>\n<tbody id=\"d-items\"></tbody>\n</table>\n<div class=\"tig-tot\" id=\"d-tot\"></div>\n<div class=\"tig-gstline\" id=\"d-gstline\"></div>\n<div class=\"tig-doc-foot\" id=\"d-foot\"></div>\n</div>\n</div>\n</div>\n<div class=\"tig-shell tig-sec tig-noprint\">\n<h2 class=\"tig-h2\">What makes an invoice a valid tax invoice</h2>\n<div class=\"tig-prose\">\n<p>If you are registered for GST and the sale is over $82.50 including GST, your customer needs a valid tax invoice before they can claim the GST credit. Get it wrong and they cannot claim — which is usually when they ring you to reissue it.</p>\n<h3>Every tax invoice under $1,000 must show</h3>\n<ul>\n<li>That the document is intended to be a tax invoice</li>\n<li>Your identity as the seller — business or trading name</li>\n<li>Your ABN</li>\n<li>The date the invoice was issued</li>\n<li>A description of the items sold, including quantity where relevant</li>\n<li>The GST amount, or a statement that the total price includes GST</li>\n</ul>\n<h3>Once the total reaches $1,000 or more</h3>\n<p>Add the buyer&#8217;s identity or their ABN. The generator above prompts you for it as soon as the total crosses that line.</p>\n<h3>If you are not registered for GST</h3>\n<p>You must not issue a tax invoice or charge GST. Tick the GST box off above and the document reissues as a plain invoice with no GST line — which is what you should be sending.</p>\n<h3>Keep them for five years</h3>\n<p>The ATO expects records supporting your return to be kept for five years from lodgement. A folder of PDFs is fine; a shoebox of thermal receipts that have faded to blank is not.</p>\n<p>Official source: <a href=\"https://www.ato.gov.au/businesses-and-organisations/gst-excise-and-indirect-taxes/gst/tax-invoices\" rel=\"noopener noreferrer\" target=\"_blank\">ATO: Tax invoices</a>.</p>\n</div>\n</div>\n<div class=\"tig-shell tig-sec tig-noprint\" style=\"padding-bottom:4rem\">\n<div style=\"border:1px solid var(--color-rule);border-radius:4px;background:#fff;padding:1.75rem\">\n<h2 style=\"margin:0;font-family:var(--font-sans);font-weight:600;font-size:1.25rem;color:var(--color-ink)\">Issuing a lot of these?</h2>\n<p style=\"margin:.625rem 0 1.25rem;font-size:.9375rem;line-height:1.6;max-width:40rem\">If you are invoicing regularly, the invoices become a BAS, and the BAS becomes a return. We do the bookkeeping, prepare the BAS and lodge it, for a fixed fee quoted before we start.</p>\n<div style=\"display:flex;flex-wrap:wrap;gap:.625rem\"><a class=\"tig-btn tig-btn-mint\" href=\"https://brsadvisory.myassembly.com/login?step=signUp\" target=\"_blank\" rel=\"noopener noreferrer\">Start my return</a><a class=\"tig-btn tig-btn-ghost\" href=\"/services/bookkeeping/\">Bookkeeping and BAS</a></div>\n</div>\n</div>\n<p><script>(function(){var K='xyzInvBiz';var items=[];var $=function(id){return document.getElementById(id);};\nvar F=['bizname','bizabn','bizaddr','bizemail','bizphone','clname','clabn','claddr','invno','invdate','duedate','notes'];\nfunction money(n){return '$'+(Math.round(n*100)/100).toLocaleString('en-AU',{minimumFractionDigits:2,maximumFractionDigits:2});}\nfunction esc(s){return String(s||'').replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];});}\nfunction val(id){var e=$('f-'+id);return e?e.value.trim():'';}\nfunction dfmt(s){if(!s){return '';}var p=s.split('-');if(p.length!==3){return s;}var m=['January','February','March','April','May','June','July','August','September','October','November','December'];return Number(p[2])+' '+m[Number(p[1])-1]+' '+p[0];}\nfunction abnOk(a){return String(a||'').replace(/\\D/g,'').length===11;}\nfunction abnFmt(a){var d=String(a||'').replace(/\\D/g,'');return d.length===11?d.slice(0,2)+' '+d.slice(2,5)+' '+d.slice(5,8)+' '+d.slice(8):a;}\nfunction itemRow(i){var it=items[i];return '</p>\n<div class=\"tig-item\"><button class=\"tig-del\" type=\"button\" data-del=\"'+i+'\" aria-label=\"Remove item\">Remove</button><label class=\"tig-f\"><span>Description</span><input type=\"text\" data-k=\"desc\" data-i=\"'+i+'\" value=\"'+esc(it.desc)+'\"></label></p>\n<div class=\"tig-row2\"><label class=\"tig-f\"><span>Quantity</span><input type=\"number\" min=\"0\" step=\"any\" data-k=\"qty\" data-i=\"'+i+'\" value=\"'+esc(it.qty)+'\"></label><label class=\"tig-f\"><span>Unit price ($)</span><input type=\"number\" min=\"0\" step=\"any\" data-k=\"price\" data-i=\"'+i+'\" value=\"'+esc(it.price)+'\"></label></div>\n</div>\n<p>';}\nfunction drawItems(){var h='';for(var i=0;i<items.length;i++){h+=itemRow(i);}$('tig-items').innerHTML=h;}\nfunction calc(){var sub=0;for(var i=0;i<items.length;i++){var q=Number(items[i].qty)||0,p=Number(items[i].price)||0;sub+=q*p;}var gst=$('f-gst').checked?sub*0.1:0;return {sub:sub,gst:gst,total:sub+gst};}\nfunction draw(){var g=$('f-gst').checked;var t=calc();\n$('d-title').textContent=g?'Tax invoice':'Invoice';\nvar from='<b>'+esc(val('bizname')||'Your business name')+'</b>';if(val('bizabn')){from+='ABN '+esc(abnFmt(val('bizabn')))+'\\n';}if(val('bizaddr')){from+=esc(val('bizaddr'))+'\\n';}if(val('bizemail')){from+=esc(val('bizemail'))+'\\n';}if(val('bizphone')){from+=esc(val('bizphone'));}\n$('d-from').innerHTML=from;\nvar meta='';if(val('invno')){meta+='Invoice <b>'+esc(val('invno'))+'</b><br />';}if(val('invdate')){meta+='Issued <b>'+esc(dfmt(val('invdate')))+'</b><br />';}if(val('duedate')){meta+='Due <b>'+esc(dfmt(val('duedate')))+'</b>';}\n$('d-meta').innerHTML=meta;\nvar to='';if(val('clname')){to+='<b>'+esc(val('clname'))+'</b>';}if(val('clabn')){to+='ABN '+esc(abnFmt(val('clabn')))+'\\n';}if(val('claddr')){to+=esc(val('claddr'));}\n$('d-to').innerHTML=to||'&mdash;';\nvar rows='';for(var i=0;i<items.length;i++){var it=items[i];var q=Number(it.qty)||0,p=Number(it.price)||0;if(!it.desc&#038;&#038;!q&#038;&#038;!p){continue;}rows+='\n\n<tr>\n<td>'+esc(it.desc||'&mdash;')+'</td>\n<td class=\"num\">'+(q||'')+'</td>\n<td class=\"num\">'+(p?money(p):'')+'</td>\n<td class=\"num\">'+money(q*p)+'</td>\n</tr>\n<p>';}\n$('d-items').innerHTML=rows||'</p>\n<tr>\n<td colspan=\"4\" style=\"color:var(--color-ink-soft)\">Add an item to see it here.</td>\n</tr>\n<p>';\nvar tot='';if(g){tot+='</p>\n<div><span>Subtotal</span><span>'+money(t.sub)+'</span></div>\n<div><span>GST 10%</span><span>'+money(t.gst)+'</span></div>\n<p>';}\ntot+='</p>\n<div class=\"grand\"><span>Total'+(g?' incl. GST':'')+'</span><span>'+money(t.total)+'</span></div>\n<p>';\n$('d-tot').innerHTML=tot;\n$('d-gstline').textContent=g?'Total price includes GST.':'No GST has been charged — this supplier is not registered for GST.';\n$('d-foot').textContent=val('notes');\ncomp(g,t);save();}\nfunction comp(g,t){var big=t.total>=1000;var c=[[g?'Marked as a tax invoice':'Marked as an invoice (no GST charged)',true],['Your business name',!!val('bizname')],['Your ABN, 11 digits',abnOk(val('bizabn'))],['Date issued',!!val('invdate')],['A description of what was sold',items.some(function(i){return i.desc&&(Number(i.qty)||0)*(Number(i.price)||0)>0;})],[g?'GST amount shown':'GST correctly not charged',true]];\nif(big){c.push(['Buyer identity or ABN — the total is $1,000 or more',!!(val('clname')||abnOk(val('clabn')))]);}\nvar h='';for(var i=0;i<c.length;i++){h+='\n\n<li class=\"'+(c[i][1]?'ok':'no')+'\">'+c[i][0]+'</li>\n<p>';}\n$('tig-comp').innerHTML=h;}\nfunction save(){try{var o={};['bizname','bizabn','bizaddr','bizemail','bizphone'].forEach(function(k){o[k]=val(k);});o.gst=$('f-gst').checked;localStorage.setItem(K,JSON.stringify(o));}catch(e){}}\nfunction load(){try{var o=JSON.parse(localStorage.getItem(K)||'{}');Object.keys(o).forEach(function(k){if(k==='gst'){$('f-gst').checked=o[k]!==false;}else if($('f-'+k)){$('f-'+k).value=o[k]||'';}});}catch(e){}}\n$('tig-items').addEventListener('input',function(e){var t=e.target;if(t.dataset.k){items[Number(t.dataset.i)][t.dataset.k]=t.value;draw();}});\n$('tig-items').addEventListener('click',function(e){var d=e.target.dataset.del;if(d!==undefined){items.splice(Number(d),1);if(!items.length){items.push({desc:'',qty:'1',price:''});}drawItems();draw();}});\n$('tig-add').addEventListener('click',function(){items.push({desc:'',qty:'1',price:''});drawItems();draw();});\n$('tig-print').addEventListener('click',function(){window.print();});\n$('tig-reset').addEventListener('click',function(){['clname','clabn','claddr','invno','notes'].forEach(function(k){if($('f-'+k)){$('f-'+k).value='';}});items=[{desc:'',qty:'1',price:''}];drawItems();draw();});\nF.forEach(function(k){var e=$('f-'+k);if(e){e.addEventListener('input',draw);}});\n$('f-gst').addEventListener('change',draw);\nload();items=[{desc:'',qty:'1',price:''}];\nvar d=new Date();$('f-invdate').value=d.toISOString().slice(0,10);\ndrawItems();draw();})();</script></div>\n"
  },
